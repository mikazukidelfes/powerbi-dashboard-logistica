model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 02_Fatos

	annotation PBI_QueryGroupOrder = 0

queryGroup 03_Dimensões

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fEntregas","dCentroDistribuicao","dCliente","dDestino","dMotorista","dOcorrencia","dStatus","dTransportadora","fMetas","dVeiculo","_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table fEntregas
ref table dCentroDistribuicao
ref table dCliente
ref table dDestino
ref table dMotorista
ref table dOcorrencia
ref table dStatus
ref table dTransportadora
ref table fMetas
ref table dVeiculo
ref table dCalendario
ref table _Medidas

ref cultureInfo en-US

