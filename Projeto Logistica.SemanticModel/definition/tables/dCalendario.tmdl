	column 'Mês Fechado'
		lineageTag: 922da8ad-40dd-450d-948c-82837a2e5c11
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês Fechado]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source = ```
				
				VAR _MinData = MIN ( fEntregas[Data_Coleta] )
				VAR _MaxData =
				    MAXX (
				        fEntregas,
				        MAX ( fEntregas[Data_Prevista_Entrega], fEntregas[Data_Coleta] )
				    )
				VAR _Base =
				    CALENDAR (
				        DATE ( YEAR ( _MinData ), 1, 1 ),
				        DATE ( YEAR ( _MaxData ), 12, 31 )
				    )
				RETURN
				    ADDCOLUMNS (
				        _Base,
				        "Ano", YEAR ( [Date] ),
				        "Nº Mês", MONTH ( [Date] ),
				        "Mês", FORMAT ( [Date], "MMM", "pt-BR" ),
				        "Mês Ano", FORMAT ( [Date], "MMM/yy", "pt-BR" ),
				        "Ano Mês (ordem)", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Trimestre", "T" & QUARTER ( [Date] ),
				        "Ano Trimestre", FORMAT ( [Date], "yyyy" ) & "-T" & QUARTER ( [Date] ),
				        "Semana do Ano", WEEKNUM ( [Date], 2 ),
				        "Nº Dia Semana", WEEKDAY ( [Date], 2 ),
				        "Dia da Semana", FORMAT ( [Date], "ddd", "pt-BR" ),
				        "Fim de Semana", IF ( WEEKDAY ( [Date], 2 ) > 5, "Fim de Semana", "Dia Útil" ),
				        "Início do Mês", EOMONTH ( [Date], -1 ) + 1,
				        "Fim do Mês", EOMONTH ( [Date], 0 ),
				        "Mês Fechado",
				            IF ( EOMONTH ( [Date], 0 ) <= MAX ( fEntregas[Data_Coleta] ), "Sim", "Não" )
				    )
				
				```

	annotation PBI_Id = e0ac8f3911ba4d33a59fab8873de1c69

